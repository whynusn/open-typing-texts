{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://open-typing-texts.local/schemas/ott-bridge-response.schema.json",
  "title": "OTT Bridge Response (generic-http)",
  "description": "Validates the JSON body returned by an `ott-bridge` source with `bridge_kind: \"generic-http\"`. Two shapes: a single OTT Core v1 entry, or an object with an `entries` array. `content` is required per entry.",
  "type": "object",
  "oneOf": [
    {
      "title": "Single entry",
      "required": ["content"],
      "additionalProperties": false,
      "properties": {
        "entry_id": { "type": "string" },
        "title": { "type": "string" },
        "content": { "type": "string", "minLength": 1 },
        "preview": { "type": "string" },
        "source_key": { "type": "string" },
        "char_count": { "type": "integer", "minimum": 0 },
        "tags": { "type": "array", "items": { "type": "string" } },
        "category": { "type": "string" }
      }
    },
    {
      "title": "Entry list",
      "required": ["entries"],
      "additionalProperties": false,
      "properties": {
        "entries": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": ["content"],
            "additionalProperties": false,
            "properties": {
              "entry_id": { "type": "string" },
              "title": { "type": "string" },
              "content": { "type": "string", "minLength": 1 },
              "preview": { "type": "string" },
              "source_key": { "type": "string" },
              "char_count": { "type": "integer", "minimum": 0 },
              "tags": { "type": "array", "items": { "type": "string" } },
              "category": { "type": "string" }
            }
          }
        }
      }
    }
  ]
}
